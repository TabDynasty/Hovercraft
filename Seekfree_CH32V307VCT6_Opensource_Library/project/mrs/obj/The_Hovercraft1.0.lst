#define Sobel_Gy(addr,y,x,width)    (addr[(y-1)*width+x-1]+2*addr[(y-1)*width+x]+addr[(y-1)*width+x+1]-(addr[(y+1)*width+x-1]+2*addr[(y+1)*width+x]+addr[(y+1)*width+x+1]))
